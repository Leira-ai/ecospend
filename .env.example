# URL publik aplikasi untuk canonical URL, sitemap, dan callback.
NEXT_PUBLIC_APP_URL=

# URL proyek Supabase. Kosongkan bersama anon key untuk build/mode demo.
NEXT_PUBLIC_SUPABASE_URL=

# Kunci publik (anon/publishable) Supabase; keamanan data tetap wajib memakai RLS.
# Gunakan salah satu nama: NEXT_PUBLIC_SUPABASE_ANON_KEY (legacy JWT) atau
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY (publishable key baru), sesuai yang ditampilkan dashboard.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Secret server acak (>=32 karakter) untuk menandatangani token preview impor.
# Wajib diisi di production (Vercel: IMPORT_TOKEN_SECRET sebagai Secret).
# Tanpa ini, endpoint preview impor menolak dengan 503.
IMPORT_TOKEN_SECRET=
