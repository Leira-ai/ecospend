{
  "$schema": "https://unpkg.com/knip@6.35.0/schema.json",
  "entry": [
    "src/app/**/*.{ts,tsx}",
    "src/proxy.ts",
    "next.config.ts",
    "eslint.config.mjs",
    "postcss.config.mjs",
    "vitest.config.ts",
    "playwright.config.ts",
    "tests/e2e/**/*.spec.ts",
    "src/**/*.test.{ts,tsx}",
    "src/test/setup.ts"
  ],
  "project": ["src/**/*.{ts,tsx}", "tests/**/*.ts", "*.{ts,mts,mjs}"],
  "ignore": ["next-env.d.ts", ".next/**", "public/sw.js"],
  "next": { "config": ["next.config.ts"] },
  "vitest": {
    "config": ["vitest.config.ts"],
    "entry": ["src/**/*.test.{ts,tsx}", "src/test/setup.ts"]
  },
  "playwright": {
    "config": ["playwright.config.ts"],
    "entry": ["tests/e2e/**/*.spec.ts"]
  }
}
